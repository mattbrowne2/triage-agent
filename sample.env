ANTHROPIC_API_KEY="@@ANTHROPIC_API_KEY GOES HERE"
OPENAI_API_KEY="@@OPENAI_API_KEY GOES HERE"

LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-5-5"
# LLM_REASONING_EFFORT="low"
MAX_AGENT_STEPS="25"
DATADOG_LOGS_PATH="data/datadog_logs/payment_service_bad_deploy.json"

INCIDENT_SEARCH_ENABLED="true" 
INCIDENTS_PATH="data/incidents/past_incidents.json"
EMBEDDING_MODEL="text-embedding-3-small"  
INCIDENT_MIN_SIMILARITY="0.5"  

JIRA_TICKETS_PATH="data/jira/tickets.json"  # the dummy Jira project the agent files tickets into

JUDGE_PROVIDER="anthropic"  # LLM judge in the evals; keep it a different family from the agent
JUDGE_MODEL="claude-opus-5-5"

LANGSMITH_TRACING="false"
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
LANGSMITH_API_KEY="@@LANGSMITH_API_KEY GOES HERE"
LANGSMITH_AGENT_ID="triage-agent"
LANGSMITH_AGENT_ENVIRONMENT="local"
